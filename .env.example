# ==============================================================================
# miConte — Variables de Entorno de Ejemplo (Fase 1: Entorno y Persistencia)
# Copia este archivo a `.env` para desarrollo local.
# NUNCA subas credenciales reales ni el archivo `.env` al repositorio.
# ==============================================================================

# Entorno de ejecución (development | testing | production)
MICONTE_ENVIRONMENT=development
MICONTE_APP_NAME=miConte
MICONTE_API_HOST=127.0.0.1
MICONTE_API_PORT=8000

# Configuración de PostgreSQL (usada por Docker Compose y por la aplicación)
MICONTE_POSTGRES_USER=miconte_user
MICONTE_POSTGRES_PASSWORD=miconte_dev_password_change_me
MICONTE_POSTGRES_DB=miconte_db
MICONTE_POSTGRES_HOST=127.0.0.1
MICONTE_POSTGRES_PORT=5432

# URL de conexión SQLAlchemy (psycopg v3) — base de DESARROLLO
MICONTE_DATABASE_URL=postgresql+psycopg://miconte_user:miconte_dev_password_change_me@127.0.0.1:5432/miconte_db

# URL exclusiva para pruebas de integración.
# OBLIGATORIA para ejecutar pytest: tests/conftest.py la requiere y aborta la sesión si falta.
# Debe apuntar a miconte_test_db (nunca a miconte_db).
# Configuración inicial (una sola vez):
#   docker exec miconte_postgres psql -U miconte_user -d miconte_db -c "CREATE DATABASE miconte_test_db;"
#   MICONTE_DATABASE_URL=postgresql+psycopg://miconte_user:miconte_dev_password_change_me@127.0.0.1:5432/miconte_test_db .venv/bin/alembic upgrade head
# Crea un archivo .env.test (excluido de Git) con:
#   MICONTE_TEST_DATABASE_URL=postgresql+psycopg://miconte_user:miconte_dev_password_change_me@127.0.0.1:5432/miconte_test_db
# O exporta la variable antes de correr pytest:
#   export MICONTE_TEST_DATABASE_URL=postgresql+psycopg://miconte_user:miconte_dev_password_change_me@127.0.0.1:5432/miconte_test_db

# ==============================================================================
# Seguridad Criptográfica y OAuth 2.0 (Fase 4: Integración con YouTube)
# ==============================================================================

# Clave maestra AES-256-GCM (32 bytes en formato hex de 64 caracteres o base64 de 44 caracteres)
# Generar una segura para producción: python -c "import secrets; print(secrets.token_hex(32))"
MICONTE_TOKEN_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
MICONTE_TOKEN_ENCRYPTION_KEY_ID=k1

# Secreto para firma HMAC-SHA256 del parámetro state anti-CSRF en OAuth
MICONTE_OAUTH_STATE_SECRET=dev_oauth_state_signing_secret_do_not_use_in_prod

# Credenciales de Google Cloud OAuth 2.0 Web Application
MICONTE_YOUTUBE_CLIENT_ID=
MICONTE_YOUTUBE_CLIENT_SECRET=
MICONTE_YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/youtube/callback

# API Key pública para YouTube Data API v3 (opcional, para consultas públicas)
MICONTE_YOUTUBE_API_KEY=

# ==============================================================================
# Sincronización y Planificador de Métricas (Fase 5: Sincronización e Histórico)
# ==============================================================================

# Intervalo en horas para la ejecución periódica del planificador en segundo plano
MICONTE_SYNC_INTERVAL_HOURS=24

# Habilitar o deshabilitar el planificador en segundo plano (true | false)
MICONTE_SYNC_ENABLED=true

# Límite máximo de videos recientes a procesar por canal en cada sincronización
MICONTE_SYNC_MAX_VIDEOS_PER_CHANNEL=200

# Ventana de días hacia atrás para métricas diarias de Analytics API v2
MICONTE_SYNC_ANALYTICS_DAYS=30


# ==============================================================================
# Autenticación de producción — Google OpenID Connect (Fase 10)
# ==============================================================================

# Client ID y Secret del cliente OAuth 2.0 para el flujo de login (OpenID Connect).
# Puede reutilizar el mismo cliente de Google Cloud que MICONTE_YOUTUBE_CLIENT_ID.
# OBLIGATORIOS en production. Generarlos en Google Cloud Console > APIs & Services > Credentials.
MICONTE_GOOGLE_LOGIN_CLIENT_ID=
MICONTE_GOOGLE_LOGIN_CLIENT_SECRET=

# URI de redirección registrada en Google Cloud Console para el callback de login.
# Debe coincidir exactamente con la URI registrada.
MICONTE_GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# URL base del frontend — usada como destino del redirect post-login.
MICONTE_FRONTEND_URL=http://127.0.0.1:4200

# Nombre de la cookie de sesión HttpOnly gestionada por el backend.
MICONTE_SESSION_COOKIE_NAME=miconte_session

# Duración de la sesión en segundos (por defecto: 7 días = 604800).
MICONTE_SESSION_MAX_AGE_SECONDS=604800

# ==============================================================================
# Capa de IA opcional (Fase 9: Capa de IA intercambiable)
# ==============================================================================

# ==============================================================================
# CORS — orígenes permitidos (Fase 10)
# ==============================================================================

# Lista de orígenes separados por coma que pueden llamar a la API desde el navegador.
# Dejar vacío en despliegues de origen único (frontend servido desde el mismo host que la API).
# En despliegues separados establecer el origen exacto del frontend.
# NUNCA usar "*" en producción.
# Ejemplo: MICONTE_CORS_ALLOW_ORIGINS=https://app.example.com
MICONTE_CORS_ALLOW_ORIGINS=

# ==============================================================================
# Proveedor de LLM para interpretación en lenguaje natural de resultados analíticos.
# Valores: none (por defecto, sin llamadas de red), ollama, external
# La IA nunca reemplaza los resultados deterministas del motor estadístico.
MICONTE_LLM_PROVIDER=none

# Tiempo de espera en segundos para llamadas al proveedor LLM.
MICONTE_LLM_TIMEOUT_SECONDS=30.0

# --- Ollama local (MICONTE_LLM_PROVIDER=ollama) ---
# URL base de la instancia local de Ollama.
MICONTE_OLLAMA_BASE_URL=http://localhost:11434
# Nombre del modelo Ollama a utilizar.
MICONTE_OLLAMA_MODEL=llama3.2

# --- API externa (MICONTE_LLM_PROVIDER=external) ---
# URL completa del endpoint chat/completions del proveedor externo.
MICONTE_EXTERNAL_LLM_BASE_URL=
# Clave de API del proveedor externo. NUNCA la expongas en Angular.
MICONTE_EXTERNAL_LLM_API_KEY=
# Identificador del modelo en el proveedor externo.
MICONTE_EXTERNAL_LLM_MODEL=
